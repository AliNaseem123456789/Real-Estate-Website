# Copy to ".env" inside this chatbot folder and fill in the values.

# --- Generation -------------------------------------------------------------
# Which model reasons and calls tools: "groq" or "gemini".
#
# QUOTA, because this bites immediately: Gemini's free tier allows 20
# generate_content requests per DAY PER MODEL. One turn here costs several, so
# roughly five conversations exhaust it for 24 hours - and the daily bucket is
# per model, so switching GEMINI_CHAT_MODEL gives you another 20.
# Groq's free tier is 1,000 requests and 200k tokens a day. Build on Groq;
# switch to Gemini for the demo if you prefer its answers.
REASONER_PROVIDER=groq

# With both keys set, a quota error on one provider is retried on the other
# rather than failing the conversation.
ENABLE_MODEL_FALLBACK=true

# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model names change often, and so does which ones are under load. Run
# `python scripts/bench_models.py` to measure what your key can reach.
#
# Measured on this project (Oct 2026, one sample each):
#   gemini-3.6-flash         2-6s at every thinking level          <- the safe pick
#   gemini-3-flash-preview   1.6s at low, but it is a preview model
#   gemini-3.8-flash         44s at medium, timeouts at low, 504s  <- avoid
#   gemini-3.1-flash-lite    503 under load, 23-32s when it works
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Gemini 3 models think before answering and most default to "medium", which is
# the main cause of slow replies: a turn makes several calls and each pays the
# cost. "low" is the setting for tool calling. Leave empty for the model default.
# Allowed values vary by model ("minimal" is rejected by some) - bench_models.py
# will tell you which your model accepts.
GEMINI_THINKING_LEVEL=low
# Legacy alternative, used only when GEMINI_THINKING_LEVEL is empty. -1 = unset.
GEMINI_THINKING_BUDGET=-1

# Fail fast rather than hanging. A turn makes several calls, so a generous
# timeout with retries is how one slow model becomes a request that never
# answers at all.
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=1

# Groq, for the cheap high-frequency calls (intent + slot extraction)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings -------------------------------------------------------------
# "gemini" (hosted, default), "jina" (hosted, multilingual, multimodal) or
# "local" (fastembed on CPU, no quota - good for a big one-off ingest).
#
# WHATEVER EMBEDS THE KNOWLEDGE BASE MUST ALSO EMBED THE QUERIES. Two different
# models put vectors in two different spaces and retrieval silently returns
# nonsense. Changing the provider or the dimensions means re-ingesting and
# rebuilding the Atlas index.
EMBED_PROVIDER=gemini

GEMINI_EMBED_MODEL=gemini-embedding-001
JINA_EMBED_MODEL=jina-embeddings-v4
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# gemini: anything from 128 to 3072 (768 is a good trade)
# jina:   128, 256, 512, 1024 or 2048
# local:  384 for bge-small-en-v1.5
EMBED_DIMENSIONS=768

# --- Reranking --------------------------------------------------------------
# Jina reranker, used after vector search: https://jina.ai/reranker
# Also the key for EMBED_PROVIDER=jina.
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- Data -------------------------------------------------------------------
# Same Atlas cluster the Express API uses
MONGO_URI=
MONGO_DB=realestate
VECTOR_COLLECTION=kb_chunks
VECTOR_INDEX=kb_vector_index

# The existing Express API, including the /api prefix
BACKEND_URL=http://localhost:3001/api

# --- Service ----------------------------------------------------------------
PORT=8000
# Comma-separated origins allowed to call this service
ALLOWED_ORIGINS=http://localhost:5173,https://realestatewebsite2.netlify.app
# Safe contact details the agent uses when it submits anything on a buyer's behalf
SAFE_CONTACT_PHONE=03099412527
SAFE_CONTACT_EMAIL=alinaseem21102002@gmail.com
LOG_LEVEL=INFO

# Bind only the tools each intent needs. Keep true when tokens per minute are
# the limit (Groq free); set false when requests per day are the limit (Gemini
# free), where a full tool belt can save a round trip.
SCOPE_TOOLS_BY_INTENT=true

# Per-minute token budget. Groq free tier: 8000. Gemini is far more generous
# per minute but limits requests per day instead, so raise this on Gemini.
TOKENS_PER_MINUTE=8000

# How many agent/tool round trips one turn may make. Each is a call to Gemini,
# so this is the second biggest lever on response time after the thinking level.
MAX_TOOL_LOOPS=4
