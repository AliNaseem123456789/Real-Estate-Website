# Copy this file to ".env" (in this client folder) and fill in the values.
# On Netlify, add the same names under Site settings → Environment variables.

VITE_FIREBASE_API_KEY=
# Where the website's Contact form sends emails (opens the visitor's mail app)
VITE_CONTACT_EMAIL=

# HomeMate chatbot service (the /chatbot FastAPI app). This is its OWN Render
# service, not the Express API - the Express one is proxied via netlify.toml.
VITE_AGENT_URL=http://localhost:8000
