# Copy this file to ".env" (in this api folder) and fill in the values.
# Never commit the real .env file.

# MongoDB Atlas connection string (use your NEW password)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.j16gmhw.mongodb.net/mydatabase?retryWrites=true&w=majority

# Any long random string, used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

PORT=3001

# The website address allowed to call this API
CLIENT_URL=http://localhost:5173

# Set to "production" on your hosting (makes the login cookie secure)
NODE_ENV=development

# Firebase project id, used to check Google sign-in tokens
FIREBASE_PROJECT_ID=real-estate-d2a04

# Set to true to make new listings wait for an admin's approval
REQUIRE_APPROVAL=false

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
